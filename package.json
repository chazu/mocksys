{
  "name": "mocksys",
  "version": "0.0.1",
  "description": "Agent-native CLI for local mocks and digital twins of external HTTP APIs",
  "license": "MIT",
  "bin": {
    "mocksys": "bin/mocksys"
  },
  "files": [
