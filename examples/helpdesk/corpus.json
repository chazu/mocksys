  { "method": "GET",  "path": "/v2/tickets", "expect": 200 },
  { "method": "GET",  "path": "/v2/tickets?filter=priority%20eq%20%22urgent%22", "expect": 200 },
  { "method": "GET",  "path": "/v2/tickets/tkt_001", "expect": 200 },
  { "method": "GET",  "path": "/v2/tickets/tkt_missing", "expect": 404 },
  { "method": "GET",  "path": "/v2/tickets?filter=status%20zz%201", "expect": 400 }
