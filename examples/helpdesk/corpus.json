[
  { "method": "GET",  "path": "/v2/status", "expect": 200 },
  { "method": "POST", "path": "/oauth/token",
    "headers": { "Content-Type": "application/x-www-form-urlencoded" },
    "body": "client_id=ci_acme&client_secret=s3cret", "expect": 200 },
  { "method": "POST", "path": "/oauth/token",
    "headers": { "Content-Type": "application/x-www-form-urlencoded" },
    "body": "client_id=ci_acme&client_secret=wrong", "expect": 401 },
  { "method": "POST", "path": "/v2/tickets",
    "headers": { "Content-Type": "application/json" },
