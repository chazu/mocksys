;; shadow-cljs builds: the CLI (shipped as JS; the bun binary wraps it) and the tests.
{:source-paths ["src" "test"]
 :dependencies [[funcool/promesa "11.0.678"]]
 :builds
 {:cli {:target     :node-script
        :main       mocksys.core/main
        :output-to  "out/mocksys.js"}
  ;; `npm test` compiles + runs this: a cljs.test node runner over every `*-test` ns.
  :test {:target    :node-test
         :output-to "out/test.js"
         :ns-regexp "-test$"}}}
